# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Where form submissions go -----------------------------------------
RB_NOTIFY_TO=chris@kimlerlaw.com

# --- SMTP for the kimlerlaw.com mailbox --------------------------------
# Port 587 = STARTTLS (most common), 465 = implicit TLS.
# Microsoft 365 and Google Workspace require an APP PASSWORD, not the
# normal mailbox password, when multi-factor auth is on.
RB_SMTP_HOST=smtp.office365.com
RB_SMTP_PORT=587
RB_SMTP_USER=chris@kimlerlaw.com
RB_SMTP_PASS=
RB_MAIL_FROM="Roaring Brook Website <chris@kimlerlaw.com>"

# --- Contract uploads ---------------------------------------------------
# Absolute path preferred in production. Must be OUTSIDE public/ and on a
# disk that persists across deploys. Defaults to ./.uploads
# RB_UPLOAD_DIR=/var/lib/roaringbrook/uploads

# How long the download links in Chris's email stay valid.
RB_LINK_TTL_DAYS=7

# Public URL of the site, used to build those download links.
# Without it the origin is guessed from the request.
RB_SITE_URL=https://roaringbrooktitle.com

# --- reCAPTCHA v3 (contact form) ---------------------------------------
RECAPTCHA_SECRET_KEY=
